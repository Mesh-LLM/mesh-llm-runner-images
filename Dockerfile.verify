# syntax=docker/dockerfile:1.7

ARG CANDIDATE_IMAGE
FROM ${CANDIDATE_IMAGE} AS verified

ARG CANDIDATE_IMAGE
ARG EXPECTED_ENVIRONMENT
ARG EXPECTED_BACKEND
ARG EXPECTED_MESH_REVISION
ARG EXPECTED_RUNNER_IMAGES_REVISION
ARG EXPECTED_CUDA_SERIES=none
ARG EXPECTED_ROCM_VERSION=none
ARG VERIFIER_REVISION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Browser-capable images must match the pin from this verification checkout.
# Read it independently of the candidate stamp so an omitted caller argument
# cannot turn version verification into a comparison against its own default.
COPY config/playwright-pin.txt /tmp/playwright-pin.txt

# Verification inputs are separate from the candidate's own stamps and locks.
COPY config/tool-pins.json config/cache-policy.json config/python-requirements.lock /opt/mesh-runner-verification/
COPY scripts/collect-runner-identity.py /opt/mesh-runner-verification/collect-runner-identity.py

RUN [[ "${CANDIDATE_IMAGE}" =~ @sha256:[0-9a-f]{64}$ ]] \
    && test -n "${EXPECTED_ENVIRONMENT}" \
    && test -n "${EXPECTED_BACKEND}" \
    && test -n "${EXPECTED_MESH_REVISION}" \
    && test -n "${EXPECTED_RUNNER_IMAGES_REVISION}" \
    && if [[ "${EXPECTED_BACKEND}" == web || "${EXPECTED_BACKEND}" == browser ]]; then \
         expected_playwright_version="$(cat /tmp/playwright-pin.txt)"; \
       else \
         expected_playwright_version=none; \
       fi \
    && /usr/local/bin/verify-runner-image \
       "${EXPECTED_ENVIRONMENT}" \
       "${EXPECTED_BACKEND}" \
       "${EXPECTED_MESH_REVISION}" \
       "${EXPECTED_CUDA_SERIES}" \
       "${EXPECTED_ROCM_VERSION}" \
       "${EXPECTED_RUNNER_IMAGES_REVISION}" \
       "${expected_playwright_version}" \
    && python3 /opt/mesh-runner-verification/collect-runner-identity.py \
       --expected-directory /opt/mesh-runner-verification \
       --verifier-revision "${VERIFIER_REVISION}" \
       "${EXPECTED_ENVIRONMENT}" "${EXPECTED_BACKEND}" \
       "${EXPECTED_MESH_REVISION}" "${EXPECTED_CUDA_SERIES}" \
       "${EXPECTED_ROCM_VERSION}" "${EXPECTED_RUNNER_IMAGES_REVISION}" \
       "${expected_playwright_version}" > /tmp/mesh-runner-identity.json

FROM scratch AS identity-output
COPY --from=verified /tmp/mesh-runner-identity.json /runtime-identity.json
